APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Conexão de leitura do DRHFlow (SQL Server) — fonte das vagas e destino das
# inscrições. Requer as extensões sqlsrv e pdo_sqlsrv.
# O usuário precisa de SELECT em DB_DRHFLOW_TESTE e INSERT/UPDATE restrito a
# EN_CANDIDATO_VAGA_EMPREGO. Nenhum DELETE, nenhuma permissão de DDL.
DRHFLOW_HOST=
DRHFLOW_PORT=1433
DRHFLOW_DATABASE=DB_DRHFLOW_TESTE
DRHFLOW_USERNAME=
DRHFLOW_PASSWORD=
DRHFLOW_ENCRYPT=yes
DRHFLOW_TRUST_SERVER_CERTIFICATE=true
DRHFLOW_TIMEOUT=10
# Identifica o portal em EN_CANDIDATO_VAGA_EMPREGO.ID_USUARIO_CAD (máx. 25 caracteres).
DRHFLOW_ID_USUARIO_CAD=PORTALVAGAS

# Raiz dos PDFs de currículo, organizados em uma pasta por CPF. Precisa ficar
# fora de qualquer diretório servido pela web. Em produção: /home/Curriculos
# Vazio usa o padrão storage/app/private/Curriculos.
CURRICULOS_ROOT=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Desvia TODO e-mail para um único endereço, ignorando o destinatário original.
# Obrigatório em teste e homologação, onde o banco tem e-mails de candidatos
# reais. Deve ficar VAZIO em produção.
MAIL_ALWAYS_TO=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
